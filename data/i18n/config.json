    { "uid": "api::service.service", "key": "services" },
    { "uid": "api::state-page.state-page", "key": "statePages" },
    { "uid": "api::city-page.city-page", "key": "cityPages" },
    { "uid": "api::global-setting.global-setting", "key": "globalSetting" },
    { "uid": "api::navigation.navigation", "key": "navigation" },
    { "uid": "api::footer.footer", "key": "footer" },
    { "uid": "api::home-page.home-page", "key": "homePage" },
    { "uid": "api::about-page.about-page", "key": "aboutPage" },
    { "uid": "api::services-page.services-page", "key": "servicesPage" },
    { "uid": "api::contact-page.contact-page", "key": "contactPage" },
    { "uid": "api::legal-network-page.legal-network-page", "key": "legalNetworkPage" },
