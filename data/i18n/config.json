  "$skipFields": "Text fields that are never translated: URLs, ids, contact details, people/firm/city names, form values the sales team reads. At the top level of a content type these are also shared across languages (one value for EN + ES).",
  "skipFields": [
    "slug", "href", "url", "linkHref", "ctaHref", "noticeCtaHref", "builtByHref", "canonicalUrl",
    "email", "phone", "phoneHref", "icon", "iconGrey", "iconYellow", "scrollTo",
    "mapEmbedUrl", "mapLinkUrl", "websiteUrl", "googleTagManagerId", "themeColor", "twitterHandle",
    "coverUrl", "locationLink", "formSubject", "cardLinkAnchor", "number", "code",
    "name", "firm", "author", "siteName", "builtByName", "platform", "address", "location",
    "excludePaths", "openingHoursSpec"
  ],
  "$translateAnyway": "Exceptions to skipFields, as <uid>.<field>.",
  "translateAnyway": ["api::blog-category.blog-category.name"],
  "$skipComponentFields": "Fields skipped only inside one component, as <component>.<field>.",
  "skipComponentFields": ["shared.select-option.value"],
  "$sharedComponents": "Component fields with nothing to translate — shared across languages instead of copied per language.",
  "sharedComponents": ["shared.social-link"]
}
