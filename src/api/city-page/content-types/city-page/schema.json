{
  "kind": "collectionType",
  "collectionName": "city_pages",
  "info": {
    "singularName": "city-page",
    "pluralName": "city-pages",
    "displayName": "City Page",
    "description": "A city landing page under Georgia (e.g. Atlanta)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "heroBadge": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.service-hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroAccentFirst": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "whyTrust": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "practiceAreas": {
      "type": "component",
      "repeatable": false,
      "component": "shared.feature-grid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "whyChoose": {
      "type": "component",
      "repeatable": false,
      "component": "shared.why-choose",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "stepsToTake": {
      "type": "component",
      "repeatable": false,
      "component": "shared.steps-to-take",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "damages": {
      "type": "component",
      "repeatable": false,
      "component": "shared.damages",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "testimonials": {
      "type": "component",
      "repeatable": false,
      "component": "shared.testimonials",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "georgiaLaw": {
      "type": "component",
      "repeatable": false,
      "component": "shared.info-cards",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "autoNearbyCities": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "nearbyCities": {
      "type": "component",
      "repeatable": false,
      "component": "shared.nearby-cities",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faq": {
      "type": "component",
      "repeatable": false,
      "component": "shared.faq",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
