{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service (Sub-service)",
    "description": "A sub-service under a category (e.g. Car Accidents). Drives the parent category's case grid."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-category.service-category",
      "inversedBy": "services"
    },
    "cardIcon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "cardDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cardLinkText": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cardLinkAnchor": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.service-hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "whatToKnow": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "howItWorks": {
      "type": "component",
      "repeatable": false,
      "component": "shared.how-it-works",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "typesOfCases": {
      "type": "component",
      "repeatable": false,
      "component": "shared.feature-grid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "stepsToTake": {
      "type": "component",
      "repeatable": false,
      "component": "shared.steps-to-take",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "damages": {
      "type": "component",
      "repeatable": false,
      "component": "shared.damages",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "testimonials": {
      "type": "component",
      "repeatable": false,
      "component": "shared.testimonials",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faq": {
      "type": "component",
      "repeatable": false,
      "component": "shared.faq",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
