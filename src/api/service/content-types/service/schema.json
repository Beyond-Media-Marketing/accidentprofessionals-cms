{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service (Sub-service)",
    "description": "A sub-service under a category (e.g. Car Accidents). Drives the parent category's case grid."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::service-category.service-category",
      "inversedBy": "services"
    },
    "cardIcon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "cardDescription": {
      "type": "text"
    },
    "cardLinkText": {
      "type": "string"
    },
    "cardLinkAnchor": {
      "type": "string"
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.service-hero"
    },
    "whatToKnow": {
      "type": "component",
      "repeatable": false,
      "component": "shared.media-text"
    },
    "howItWorks": {
      "type": "component",
      "repeatable": false,
      "component": "shared.how-it-works"
    },
    "typesOfCases": {
      "type": "component",
      "repeatable": false,
      "component": "shared.feature-grid"
    },
    "stepsToTake": {
      "type": "component",
      "repeatable": false,
      "component": "shared.steps-to-take"
    },
    "damages": {
      "type": "component",
      "repeatable": false,
      "component": "shared.damages"
    },
    "testimonials": {
      "type": "component",
      "repeatable": false,
      "component": "shared.testimonials"
    },
    "faq": {
      "type": "component",
      "repeatable": false,
      "component": "shared.faq"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
