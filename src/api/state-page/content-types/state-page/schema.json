{
  "kind": "collectionType",
  "collectionName": "state_pages",
  "info": {
    "singularName": "state-page",
    "pluralName": "state-pages",
    "displayName": "State Page",
    "description": "A state landing page (e.g. Georgia)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "heroBadge": {
      "type": "string"
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.service-hero"
    },
    "heroAccentFirst": {
      "type": "boolean",
      "default": false
    },
    "heroStats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "cities": {
      "type": "component",
      "repeatable": false,
      "component": "shared.city-areas"
    },
    "practiceAreas": {
      "type": "component",
      "repeatable": false,
      "component": "shared.feature-grid"
    },
    "facts": {
      "type": "component",
      "repeatable": false,
      "component": "shared.facts"
    },
    "testimonials": {
      "type": "component",
      "repeatable": false,
      "component": "shared.testimonials"
    },
    "faq": {
      "type": "component",
      "repeatable": false,
      "component": "shared.faq"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
