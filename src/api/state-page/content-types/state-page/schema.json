{
  "kind": "collectionType",
  "collectionName": "state_pages",
  "info": {
    "singularName": "state-page",
    "pluralName": "state-pages",
    "displayName": "State Page",
    "description": "A state landing page (e.g. Georgia)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "heroBadge": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.service-hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroAccentFirst": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "heroStats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cities": {
      "type": "component",
      "repeatable": false,
      "component": "shared.city-areas",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "practiceAreas": {
      "type": "component",
      "repeatable": false,
      "component": "shared.feature-grid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "facts": {
      "type": "component",
      "repeatable": false,
      "component": "shared.facts",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "testimonials": {
      "type": "component",
      "repeatable": false,
      "component": "shared.testimonials",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faq": {
      "type": "component",
      "repeatable": false,
      "component": "shared.faq",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
