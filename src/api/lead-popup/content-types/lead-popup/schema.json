{
  "kind": "singleType",
  "collectionName": "lead_popups",
  "info": {
    "singularName": "lead-popup",
    "pluralName": "lead-popups",
    "displayName": "Lead Popup",
    "description": "Timed popup contact form shown site-wide. `enabled` is a kill switch — turn it off here to remove the popup with no deploy. Delays are in seconds. `excludePaths` is a JSON array of paths to suppress it on, e.g. [\"/contact-us\"]. `frequency`: session = once per browser session, once = once ever, always = every page load. Turn `showOnMobile` off (or raise `mobileDelaySeconds`) if Search Console reports an intrusive interstitial."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "delaySeconds": {
      "type": "integer",
      "default": 3,
      "min": 0,
      "max": 120,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "mobileDelaySeconds": {
      "type": "integer",
      "default": 3,
      "min": 0,
      "max": 120,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "showOnMobile": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "frequency": {
      "type": "enumeration",
      "enum": [
        "session",
        "once",
        "always"
      ],
      "default": "session",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "excludePaths": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "eyebrow": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heading": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "headingAccent": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "subheading": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "submitLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "successMessage": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "disclaimer": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
