{
  "kind": "collectionType",
  "collectionName": "service_categories",
  "info": {
    "singularName": "service-category",
    "pluralName": "service-categories",
    "displayName": "Service Category",
    "description": "A top-level service category page (e.g. Auto Accidents)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.service-hero",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "howItWorks": {
      "type": "component",
      "repeatable": false,
      "component": "shared.how-it-works",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "caseTypesHeading": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "caseTypesSubheading": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "whyUs": {
      "type": "component",
      "repeatable": false,
      "component": "shared.why-us",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "stepsToTake": {
      "type": "component",
      "repeatable": false,
      "component": "shared.steps-to-take",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faq": {
      "type": "component",
      "repeatable": false,
      "component": "shared.faq",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ctaBanner": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta-banner",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::service.service",
      "mappedBy": "category"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
